# Settings for `docker compose --profile app up`. Copy to .env (next to docker-compose.yml).

# Required: signs sessions and links. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where people open the app (used in email links and as the allowed origin).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Secure cookies need HTTPS, except on http://localhost. Set false only for plain-HTTP testing
# on another host name.
COOKIE_SECURE=true

# Emails go to Mailpit (http://localhost:8025) unless you point these at a real SMTP server.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# EMAIL_FROM=Secureye <no-reply@example.com>
