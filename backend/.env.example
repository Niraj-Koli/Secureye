# Copy to `.env` and adjust. Every variable is optional in development; defaults live in app/core/config.py.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# true = JSON log lines (default in production), false = colored console output
# LOG_JSON=false

# Matches the `db` service in ../docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+asyncpg://secureye:secureye@localhost:5433/secureye
DATABASE_ECHO=false
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----------------------------------------------------------------
# REQUIRED in production: a random string of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ACTIVATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_HOURS=2
# Refresh cookie over HTTPS only (defaults to true in production).
# COOKIE_SECURE=false

# Web app base URL, used for links in emails.
FRONTEND_URL=http://localhost:5173

# ---- Email ---------------------------------------------------------------
# smtp | console | memory
EMAIL_BACKEND=smtp
EMAIL_FROM=Secureye <no-reply@secureye.local>
# Defaults point at Mailpit (../docker-compose.yml); view mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# Skips a slow reverse-DNS lookup of this machine's name on every send.
SMTP_LOCAL_HOSTNAME=localhost
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false   # e.g. true for Gmail on port 587 (use an app password)
# SMTP_TLS=false

# ---- Detection models ---------------------------------------------------
# MODELS_DIR=../ml-models
IMAGE_MODEL_FILE=bestM.pt
LIVE_MODEL_FILE=bestS.pt
# cpu | cuda | cuda:0 | mps
INFERENCE_DEVICE=cpu
INFERENCE_CONCURRENCY=1
IMAGE_CONFIDENCE=0.2
IMAGE_IOU=0.3

# Video detection (tracking), defaults from the original app
VIDEO_CONFIDENCE=0.5
VIDEO_IOU=0.6
VIDEO_AGNOSTIC_NMS=true
VIDEO_TARGET_FPS=10

# ---- Background jobs --------------------------------------------------------
# celery = separate worker process (run one, see README) · inline = inside the API process
JOB_RUNNER=celery
# redis (required with celery) | memory (single process only)
JOB_EVENTS_BACKEND=redis
# CELERY_BROKER_URL=   # defaults to REDIS_URL

# ---- Uploads & storage ------------------------------------------------------
# STORAGE_DIR=./storage
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_PIXELS=50000000
MAX_VIDEO_UPLOAD_MB=500
MAX_VIDEO_DURATION_SECONDS=600
FILE_URL_TTL_SECONDS=3600

# ---- Admin -----------------------------------------------------------------
# Superuser-only admin site at /admin. Create a superuser with
#   uv run python -m app.cli create-superuser --email you@example.com --name "You"
ADMIN_ENABLED=true

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Defaults to async+<REDIS_URL>. Use async+memory:// to run without Redis (single process only).
# RATE_LIMIT_STORAGE_URL=

# ---- Live detection -----------------------------------------------------------
LIVE_CONFIDENCE=0.4
# The original used 0.0, which dropped overlapping same-class objects.
LIVE_IOU=0.45
LIVE_TARGET_FPS=10
LIVE_MAX_SESSION_MINUTES=60
LIVE_MAX_SESSIONS_PER_USER=2
